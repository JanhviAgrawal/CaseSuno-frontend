# ---------------------------------------------------------------
# CASE SUNO website (Next.js) — copy to .env.local for development.
# In production set these in your hosting panel.
# ---------------------------------------------------------------

# Public URL of the website (used for tracking links, sitemap, share previews)
NEXT_PUBLIC_SITE_URL=https://casesuno.in

# CASE SUNO API on Render (no trailing slash)
#   e.g. https://casesuno-api.onrender.com   or   https://api.casesuno.in
BACKEND_API_URL=https://casesuno-api.onrender.com

# Shared secret — must be IDENTICAL to WEBSITE_API_KEY on the Render backend.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBSITE_API_KEY=

# Optional: how long to wait for the API (ms). Render's free plan can take ~50s to wake up.
BACKEND_TIMEOUT_MS=60000
